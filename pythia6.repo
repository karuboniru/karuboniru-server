[pythia6]
name=Copr repo for root6-cuda owned by yanqiyu
baseurl=https://download.copr.fedorainfracloud.org/results/yanqiyu/root6-cuda/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/yanqiyu/root6-cuda/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
